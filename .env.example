# =============================================================
#  Configuração do Bot WhatsApp → Google Sheets
# =============================================================

# ID do grupo do WhatsApp
# Para descobrir o ID, rode: npm run groups
# O ID tem formato tipo: 5511999999999-1234567890@g.us
WHATSAPP_GROUP_ID=

# ID da planilha do Google Sheets
# Copie da URL: https://docs.google.com/spreadsheets/d/ESTE_ID_AQUI/edit
GOOGLE_SHEET_ID=

# Nome da aba na planilha (padrão: Agendamentos)
GOOGLE_SHEET_TAB=Agendamentos

# Caminho para o arquivo de credenciais da Service Account do Google
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Porta do Painel de Controle Web (Dashboard)
DASHBOARD_PORT=3000

# Configuração de Preço do Transporte / Guincho
VALOR_POR_KM=7.00
CALCULAR_IDA_E_VOLTA=true
